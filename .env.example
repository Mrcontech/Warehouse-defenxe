# Copy to .env.local (npm start does this for you on the first run).
# Defaults match a fresh XAMPP install: MySQL on 127.0.0.1:3306, user root, no password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ebsu_dw

# Dashboard login (created on first run if it does not exist).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ebsu-dw-2025
ADMIN_FULL_NAME=MIS Administrator

# Signs the login cookie. npm start writes a random value here on the first run.
SESSION_SECRET=

# Python used by the "Run ETL" button. npm start fills this in with the
# project's virtual environment (.venv) on the first run.
PYTHON_BIN=
